+static term nif_erlang_md5(Context *ctx, int argc, term argv[])
+{
+    UNUSED(argc);
+#ifdef ATOMVM_HAS_MBEDTLS
+    term data = argv[0];
+    const void *data_ptr;
+    size_t data_size;
+    char *alloc_ptr = NULL;
+
+    if (LIKELY(term_is_binary(data))) {
+        data_ptr = term_binary_data(data);
+        data_size = term_binary_size(data);
+    } else if (LIKELY(term_is_list(data) || term_is_nil(data))) {
+        char *buf = NULL;
+        term status = iolist_to_buffer(data, &buf, &data_size);
+        if (UNLIKELY(status != OK_ATOM)) {
+            RAISE_ERROR(status);
+        }
+        data_ptr = buf;
+        alloc_ptr = buf;
+    } else {
+        RAISE_ERROR(BADARG_ATOM);
+    }
+
+    unsigned char digest[16];
+    mbedtls_md5((const unsigned char *) data_ptr, data_size, digest);
+    free(alloc_ptr);
+
+    if (UNLIKELY(memory_ensure_free(ctx, term_binary_heap_size(16)) != MEMORY_GC_OK)) {
+        RAISE_ERROR(OUT_OF_MEMORY_ATOM);
+    }
+    return term_from_literal_binary(digest, 16, &ctx->heap, ctx->global);
+#else
+    RAISE_ERROR(UNDEF_ATOM);
+#endif
+}
